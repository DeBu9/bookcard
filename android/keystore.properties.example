# 签名凭据模板。
#
# 用法：复制成 android/keystore.properties 后填入自己的信息。
#   cp android/keystore.properties.example android/keystore.properties
#
# keystore.properties 已在 .gitignore 中，不会被提交。
# 若只是想让项目跑起来，可以跳过本文件：直接出调试包 `bash build-apk.sh debug`。
#
# 生成自己的 keystore（把密码换成你自己的）：
#   keytool -genkeypair -v -keystore android/keystore/my.keystore \
#     -alias bookcard -keyalg RSA -keysize 2048 -validity 10000 \
#     -storepass 你的密码 -keypass 你的密码 \
#     -dname "CN=你的名字, O=你的组织, C=CN"
#
# ⚠️ keystore 文件与密码必须长期保存。同一包名的后续版本只能用同一签名，
#    一旦丢失或更换，老用户无法覆盖安装，必须卸载重装（数据清空）。

# 路径相对于 android/ 目录
storeFile=keystore/bookcard.keystore
storePassword=你的密码
keyAlias=bookcard
keyPassword=你的密码
